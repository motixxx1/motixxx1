# Zariz server settings — edit, then restart the server.
# Lines starting with # are ignored.

# Port the server listens on (open it in the firewall).
PORT=3000

NODE_ENV=production

# Your business name and support email: shown in the privacy policy, terms and
# account-deletion pages (/privacy, /terms, /delete-account). Required for the app stores.
# BUSINESS_NAME=זריז
# SUPPORT_EMAIL=support@your-domain.co.il

# Login needs an SMS provider (below). Without one, nobody can sign in.
# Demo mode (login code shown on screen, anyone can enter as any number) is for trying the
# app at home only: uncomment the next line, and never on a public server.
# DEMO_MODE=1

# Your phone number(s), comma separated — they can log in as admin (approve pro documents).
# ADMIN_PHONES=0501234567

# ---- SMS login codes: choose ONE ----
# a) Any Israeli SMS gateway with an HTTP API (019, InforU, Cellact, Micropay...).
#    {phone} = 972501234567, {phone0} = 0501234567, {text} = the message.
# SMS_HTTP_URL=https://gateway.example.co.il/send?user=USER&pass=PASS&sender=Zariz&to={phone0}&msg={text}
#    For a POST API also set:
# SMS_HTTP_METHOD=POST
# SMS_HTTP_BODY={"to":"{phone}","message":"{text}"}
# SMS_HTTP_HEADERS={"Authorization":"Bearer YOUR_KEY"}
# b) Twilio (twilio.com):
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM=+1...

# Google Play / App Store reviewers can't get your SMS: give them this phone and code in the
# store's "App access" form. No SMS is sent to this number. Pick your own digits.
# REVIEW_LOGIN=0500000000:246810

# ---- Money (both off at launch) ----
# LEAD_FEES=1   each offer costs the pro credit; pros buy credit in the app (see TOPUP_URL)
# PAYMENTS=1    secure in-app card payment + travel (turn on once a payment provider is connected)

# ---- Buying credit (needs LEAD_FEES=1) ----
# TOPUP_URL is the payment page opened for the pro. Use any provider that gives a payment link
# or hosted checkout (PayPlus, Meshulam/Grow, Cardcom, Tranzila, Stripe Payment Links...).
# {amount} {ref} {phone} are filled in. When the payment succeeds, the provider must call
#   POST https://YOUR-SERVER/api/payments/webhook?secret=PAYMENT_WEBHOOK_SECRET
# with {"ref": "<the {ref} value>", "status": "paid"}. The credit is then added automatically, once.
# TOPUP_URL=https://pay.example.co.il/checkout?sum={amount}&ref={ref}
# PAYMENT_WEBHOOK_SECRET=choose-a-long-random-string

# ---- Fixed HTTPS address for a home server (free) ----
# 1) duckdns.org → sign in → create a name (e.g. zariz-app) → copy the token.
# 2) In the router forward ports 80 and 443 (TCP) to this computer.
# 3) Fill these two lines, then run:  sudo ./https-setup.sh
# The server keeps the name pointed at your home IP; the apps use https://NAME.duckdns.org
# DUCKDNS_DOMAIN=zariz-app
# DUCKDNS_TOKEN=

# ---- Automatic updates ----
# The downloaded server updates itself from GitHub (new screens arrive without a new APK).
# AUTO_UPDATE=0 turns it off.

# Travel suppliers (only with PAYMENTS=1; test in their sandbox first):
# RATEHAWK_KEY_ID=
# RATEHAWK_API_KEY=
# DUFFEL_TOKEN=

# Database: SQLite file ./data/zariz.db (daily backups in ./data/backups, last 7 kept).
# Data from the older ./data/state.json is imported automatically on first start.
# DB_FILE=/var/lib/zariz/zariz.db

# ---- Private GitHub repository ----
# Updates for this server and the apps' APKs come from the GitHub release. When the repository
# is private, create a fine-grained token (GitHub > Settings > Developer settings > Fine-grained
# tokens): only this repository, permission "Contents: Read-only". Paste it here.
# GITHUB_TOKEN=github_pat_xxxxxxxx
