# ProMarket server settings — edit, then restart the server.
# Lines starting with # are ignored.

# Port the server listens on (open it in the firewall).
PORT=3000

NODE_ENV=production

# Demo mode: login code is shown on screen (no SMS), wallet top-up without payment,
# demo travel suppliers. Anyone can log in as any phone number — test data only!
# Remove this line once SMS (Twilio) and payments are connected.
DEMO_MODE=1

# Your phone number(s), comma separated — they can log in as admin.
# ADMIN_PHONES=0501234567

# Real SMS login codes (twilio.com):
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM=+1...

# Travel suppliers (test in their sandbox first):
# RATEHAWK_KEY_ID=
# RATEHAWK_API_KEY=
# DUFFEL_TOKEN=

# Where data is saved (default: ./data/state.json inside this folder).
# DATA_FILE=/var/lib/promarket/state.json
