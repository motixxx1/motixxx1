[
  {"id": "1", "text": "הכיור סתום? שוב?!", "nikud": "הַכִּיּוֹר סָתוּם? שׁוּב?!"},
  {"id": "2", "text": "פותחים את זריז.", "nikud": "פּוֹתְחִים אֶת זָרִיז."},
  {"id": "3", "text": "בוחרים מה צריך, וקובעים מחיר.", "nikud": "בּוֹחֲרִים מָה צָרִיךְ, וְקוֹבְעִים מְחִיר."},
  {"id": "4", "text": "אצל יוסי, הקריאה קופצת מיד.", "nikud": "אֵצֶל יוֹסִי, הַקְּרִיאָה קוֹפֶצֶת מִיָּד."},
  {"id": "5", "text": "הראשון שמאשר, מקבל!", "nikud": "הָרִאשׁוֹן שֶׁמְּאַשֵּׁר, מְקַבֵּל!"},
  {"id": "6", "text": "ורחל רואה אותו מגיע, בזמן אמת.", "nikud": "וְרָחֵל רוֹאָה אוֹתוֹ מַגִּיעַ, בִּזְמַן אֱמֶת."},
  {"id": "7", "text": "הגיע, תיקן, חמישה כוכבים.", "nikud": "הִגִּיעַ, תִּקֵּן, חֲמִשָּׁה כּוֹכָבִים."},
  {"id": "8", "text": "זריז. מקצוענים וסידורים בקליק. הורידו עכשיו!", "nikud": "זָרִיז. מִקְצוֹעָנִים וְסִידּוּרִים בִּקְלִיק. הוֹרִידוּ עַכְשָׁו!"}
]
